# Copy this file to .env.local for local testing with `vercel dev`,
# and set the same two variables in Vercel: Project -> Settings -> Environment Variables.
# Never commit the real values - .env and .env.local are already gitignored.

# The Gmail address the contact form sends FROM (usually your own inbox).
CONTACT_EMAIL_USER=rajanjagz7@gmail.com

# A Gmail "App Password" - NOT your normal Google password.
# Generate one at https://myaccount.google.com/apppasswords
# (requires 2-Step Verification to be enabled on the account first).
# It's a 16-character code like "abcd efgh ijkl mnop" - paste it with no spaces.
CONTACT_EMAIL_APP_PASSWORD=

# Optional: where the message is delivered TO, if different from CONTACT_EMAIL_USER.
# CONTACT_EMAIL_TO=rajanjagz7@gmail.com
