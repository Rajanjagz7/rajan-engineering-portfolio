# Copy this file to ".env" and fill it in. Never commit .env.

# Your PMX site (no trailing slash)
PMX_URL=https://pmx.yourcompany.com

# The board to add bugs to: open the project in PMX, go to the Development tab, copy everything after the domain
PMX_BOARD_PATH=/dashboard/projects/PROJECT_ID/board?taskTab=development

# Your bug sheet (.xlsx or .csv). Use forward slashes on Windows too.
PMX_BUGS_FILE=templates/bugs-template.csv

# Optional
# PMX_SHEET=Bugs                 # worksheet name; default = first sheet (a .csv sheet is called Sheet1)
# PMX_ASSIGNEE=First Last        # assign every bug to this person (exact name as shown in PMX)
# PMX_SECTION=Done              # put every bug in this section/status instead of the sheet's Section column
# PMX_LIMIT=1                    # only the first N rows (use this for a first trial)
# PMX_ONLY=Login||Checkout       # only rows whose title contains one of these texts
# PMX_AUTH=test-data/auth.json   # where "npm run login" saves your session
